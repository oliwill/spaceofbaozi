{
  "name": "baozi-space",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "baozi.space — 包子的个人网站、公开档案与个人工作空间",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "check": "astro check",
    "fonts:subset": "node scripts/subset-fonts.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pages": "playwright test --config playwright.pages.config.ts",
    "pages:fixtures": "bun scripts/pages/prepare-fixtures.ts",
    "publish": "node scripts/subset-fonts.mjs && git add -A && git commit -m \"content: update\" && git push",
    "deploy:cf": "bun run build && wrangler deploy",
    "publishing:check": "bun scripts/publishing/cli.ts check",
    "publishing:start": "bun scripts/publishing/cli.ts start",
    "publishing:prepare": "bun scripts/publishing/cli.ts prepare",
    "publishing:guard": "bun scripts/publishing/cli.ts guard",
    "publishing:verify": "bun scripts/publishing/cli.ts verify",
    "publishing:audit": "bun scripts/publishing/cli.ts audit"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@waline/client": "^3.15.2",
    "astro": "^5.12.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "motion": "^13.1.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "sharp": "^0.35.3",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10",
    "yaml": "2.9.0",
    "rehype-raw": "7.0.0",
    "@types/hast": "3.0.5",
    "@astrojs/markdown-remark": "6.3.11",
    "hast-util-to-html": "9.0.5",
    "parse5": "7.3.0",
    "postcss": "8.5.22",
    "css-tree": "3.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
