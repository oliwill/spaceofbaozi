---
import { servedUrl } from "@/lib/site/paths";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import AlbumCharacters from "@/components/photos/AlbumCharacters.astro";
import ShellLayout from "@/components/layout/ShellLayout.astro";
import AlbumReader from "@/components/photos/AlbumReader.astro";
import "@/components/photos/photos.css";
import { publishableAlbums } from "@/lib/photos/albums";
import { auditPublicPhotoAssets } from "@/lib/photos/assetAudit.server";
import "@/components/editorial/editorial.css";
export const getStaticPaths = (async()=>{const albums=publishableAlbums(await getCollection("photos"));await auditPublicPhotoAssets(albums,"./public");return albums.map(album=>({params:{slug:album.id},props:{album}}));}) satisfies GetStaticPaths;
const {album}=Astro.props;
---
<ShellLayout photos="reader" title={`${album.title} · Photos · baozi.space`} description={album.introduction}>
<article class="editorial-page album-detail"><a class="album-detail__back" href={servedUrl('/photos')} data-album-return>← 返回影集</a><header><h1>{album.title}</h1>{(album.periodLabel??album.date)&&<p class="album-detail__period">{album.periodLabel??album.date?.getFullYear()}</p>}{album.introduction&&<p class="album-detail__introduction">{album.introduction}</p>}</header><AlbumCharacters role="jiale" phase="reading"/><AlbumReader album={album}/></article>

</ShellLayout>
