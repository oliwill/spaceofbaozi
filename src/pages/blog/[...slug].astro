---
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import ShellLayout from "@/components/layout/ShellLayout.astro";
import BookSpread from "@/components/layout/BookSpread.astro";
import { getSection } from "@/lib/sections";

export const getStaticPaths = (async () => {
  const entries = await getCollection("blog", ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const section = getSection("blog")!;
---

<ShellLayout title={`${entry.data.title} · ${section.title} · baozi.space`} description={entry.data.description || section.desc}>
  <BookSpread section={section} entry={entry} navVariant="tags" />
</ShellLayout>
