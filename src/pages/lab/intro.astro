---
import IntroSequence from "@/components/intro/IntroSequence.astro";
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#eef0ea" />
    <title>启动动画实验 · baozi.space</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <IntroSequence />
  </body>
</html>

<style is:global>
  *, *::before, *::after { box-sizing: border-box; }
  html { background: #eef0ea; }
  body { margin: 0; font-family: system-ui, "Microsoft YaHei", sans-serif; }
  a { color: inherit; }
  .skip-link {
    position: fixed;
    left: 16px;
    top: 8px;
    z-index: 100;
    padding: 10px 14px;
    background: #fffdf7;
    color: #25231f;
    transform: translateY(-160%);
  }
  .skip-link:focus { transform: translateY(0); }
</style>
