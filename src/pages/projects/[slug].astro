---
import { servedUrl } from "@/lib/site/paths";
import { getCollection, render, type CollectionEntry } from "astro:content";
import { selectPublicProjects, type PublicProject } from "@/lib/projects/projects";
import type { GetStaticPaths } from "astro";
import ShellLayout from "@/components/layout/ShellLayout.astro";
import ProjectHeader from "@/components/projects/ProjectHeader.astro";
import "@/components/editorial/editorial.css";
import "@/components/projects/projects.css";

export const getStaticPaths = (async () => {
  const projects = selectPublicProjects(await getCollection("projects"));
  return projects.map(({ entry, project }) => ({
    params: { slug: project.id },
    props: { entry, project },
  }));
}) satisfies GetStaticPaths;

interface Props {
  entry: CollectionEntry<"projects">;
  project: PublicProject;
}
const { entry, project } = Astro.props;
const { Content } = await render(entry);
---

<ShellLayout title={`${project.title} · 项目 · baozi.space`} description={project.intro}>
  <article class="editorial-page projects-detail" data-project-detail data-project-id={project.id}>
    <ProjectHeader project={project} />
    <div class="editorial-prose">
      <Content />
    </div>
    <footer class="project-footer">
      {project.link && <a class="project-footer__external" href={servedUrl(project.link)} target="_blank" rel="noopener noreferrer">{project.linkLabel}</a>}
      <a class="project-return" href={servedUrl('/projects')} data-project-return>返回项目</a>
    </footer>
  </article>
</ShellLayout>
