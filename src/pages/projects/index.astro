---
import { getCollection } from "astro:content";
import { selectPublicProjects } from "@/lib/projects/projects";
import { auditPublicProjectAssets } from "@/lib/projects/assetAudit.server";
import ShellLayout from "@/components/layout/ShellLayout.astro";
import ProjectList from "@/components/projects/ProjectList.astro";
import "@/components/editorial/editorial.css";
import "@/components/projects/projects.css";

const projects = selectPublicProjects(await getCollection("projects")).map(({ project }) => project);
await auditPublicProjectAssets(projects, "./public");
---

<ShellLayout title="项目 · baozi.space" description="参与、完成与持续试验的项目。" noindex={projects.length === 0}>
  <ProjectList projects={projects} />
</ShellLayout>
