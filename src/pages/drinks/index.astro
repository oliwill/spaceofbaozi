---
import { getCollection } from "astro:content";
import SectionLayout from "@/components/layout/SectionLayout.astro";
import EntryList from "@/components/layout/EntryList.astro";
import { getSection } from "@/lib/sections";

const section = getSection("drinks")!;
const entries = await getCollection("drinks");
---

<SectionLayout section={section}>
  <EntryList entries={entries} />
</SectionLayout>