---
import { getCollection } from "astro:content";
import { isPublishable } from "@/lib/content/gates";
import type { GetStaticPaths } from "astro";
import EntryDetail from "@/components/layout/EntryDetail.astro";
import { getSection } from "@/lib/sections";

export const getStaticPaths = (async () => {
  const entries = await getCollection("drinks", ({ data }) => isPublishable(data));
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const section = getSection("drinks")!;
---

<EntryDetail section={section} entry={entry} />
