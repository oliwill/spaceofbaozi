---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import "@/styles/neat-annotations.css";
import "@/styles/journal.css";
import { getSection, greetingByHour } from "@/lib/sections";

const initialGreeting = greetingByHour();
const blog = getSection("blog")!;
const thoughts = getSection("thoughts")!;
const photos = getSection("photos")!;
const about = getSection("about")!;
---

<BaseLayout
  title="baozi.space — 中华一番包子铺"
  description="打开一本属于包子的手账，在纸张、照片、标签和手写记录之间认识他的文章、想法、摄影、酒、书、音乐和 AI 创作。"
  bodyClass="home-body"
>
  <script is:inline>
    document.documentElement.classList.add("js");
  </script>

  <div class="book-stage" id="book-stage">
    <div class="scale-wrap">
      <!-- 打开的手账：单页平铺网点纸（默认可见，无 JS 降级路径） -->
      <main class="paper" id="paper">
        <header class="greeting-block settle" style="--d: 0ms">
          <p class="greeting">
            <span id="greeting-time">{initialGreeting}</span>，欢迎光临中华一番包子铺
          </p>
          <p class="intro-note">
            这里不是博客，也不是商店。<br />
            是一本会不断变厚的数字手账。
          </p>
        </header>

        <span class="date-stamp settle" id="date-stamp" style="--d: 60ms" aria-hidden="true"
          >2026 · 07 · 24</span
        >
        <span class="site-mark settle" style="--d: 60ms" aria-hidden="true">baozi.space</span>

        <!-- 主锚点：Blog -->
        <a href={blog.href} class="entry entry-blog settle" style="--d: 120ms" data-entry="blog">
          <span class="entry-note" aria-hidden="true">{blog.number} · {blog.title} · {blog.zh}</span>
          <span class="paper-scrap">
            <span class="tape tape-top" aria-hidden="true"></span>
            <span class="entry-big">Blog</span>
            <span class="entry-sub">文章记录 · 长文与专题</span>
          </span>
        </a>

        <!-- Thoughts：便利贴 -->
        <a
          href={thoughts.href}
          class="entry entry-thoughts settle"
          style="--d: 180ms"
          data-entry="thoughts"
        >
          <span class="entry-note" aria-hidden="true"
            >{thoughts.number} · {thoughts.title} · {thoughts.zh}</span
          >
          <span class="sticky-note">
            <span class="sticky-quote">今日想法：<br />把网页当成房间来布置。</span>
            <span class="sticky-label">Thoughts</span>
          </span>
        </a>

        <!-- 装饰：可拖动纸签 -->
        <div
          class="deco-tag draggable settle"
          style="--d: 240ms"
          id="deco-tag"
          role="img"
          aria-label="装饰纸签：待整理清单"
        >
          <span class="tape tape-top" aria-hidden="true"></span>
          <p>待整理：照片、酒标、唱片清单。</p>
        </div>

        <!-- 装饰：手绘箭头（指向 Photos） -->
        <svg
          class="deco-arrow settle"
          style="--d: 300ms"
          width="150"
          height="110"
          viewBox="0 0 150 110"
          aria-hidden="true"
        >
          <path
            d="M132 14 C 96 30, 66 52, 38 84 M 38 84 l -3 -16 M 38 84 l 15 -6"
            fill="none"
            stroke="currentColor"
            stroke-width="3"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
        </svg>

        <!-- Photos：文字标签 + 手绘圈画 -->
        <a
          href={photos.href}
          class="entry entry-photos settle"
          style="--d: 320ms"
          data-entry="photos"
        >
          <span class="entry-note" aria-hidden="true"
            >{photos.number} · {photos.title} · {photos.zh}</span
          >
          <span class="entry-photos-body">
            <span class="entry-big">Photos</span>
            <span class="entry-sub">胶片与生活</span>
            <svg class="scribble-circle" viewBox="0 0 260 120" aria-hidden="true">
              <ellipse
                cx="130"
                cy="60"
                rx="122"
                ry="52"
                fill="none"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-dasharray="760 40"
                transform="rotate(-2 130 60)"></ellipse>
            </svg>
          </span>
        </a>

        <span class="deco-scribble settle" style="--d: 360ms" aria-hidden="true">记录中 →</span>

        <!-- About：小纸签 -->
        <a
          href={about.href}
          class="entry entry-about settle"
          style="--d: 380ms"
          data-entry="about"
        >
          <span class="entry-note" aria-hidden="true"
            >{about.number} · {about.title} · {about.zh}</span
          >
          <span class="paper-tag">
            <span class="tape tape-top" aria-hidden="true"></span>
            <span class="entry-big">About</span>
            <span class="entry-sub">你好，我是包子</span>
          </span>
        </a>
      </main>

      <!-- 合上的手账封面（JS 就绪后才接管开本；无 JS 时保持隐藏） -->
      <div class="book-closed" id="book-closed" aria-hidden="true">
        <div class="book-cover">
          <img
            class="cover-img"
            src="/assets/home/cover@A.webp"
            alt="合上的手账封面"
            width="728"
            height="929"
          />
          <span class="cover-title">中华一番</span>
          <span class="cover-subtitle">包子铺</span>
        </div>
      </div>
    </div>
  </div>

  <button class="replay-btn" id="replay-btn" type="button" aria-label="重新播放打开动效">
    ↻ 重新打开
  </button>

  <script is:inline src="/scripts/journal.js"></script>
</BaseLayout>
