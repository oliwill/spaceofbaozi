---
import ShellLayout from "@/components/layout/ShellLayout.astro";
import IntroOilStage from "@/components/intro-oil/IntroOilStage.astro";
import HomeContent from "@/components/home/HomeContent.astro";
import { getCollection } from "astro:content";
import { isPublishable } from "@/lib/content/gates";
import { selectPublicProjects } from "@/lib/projects/projects";

const posts = (await getCollection("blog", ({ data }) => isPublishable(data)))
  .sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const projects = selectPublicProjects(await getCollection("projects"))
  .slice(0, 3).map(({ project }) => project);
---

<ShellLayout home>
  <IntroOilStage slot="intro" />
  <HomeContent posts={posts} projects={projects} />
</ShellLayout>
