---
import BaseLayout from "@/components/layout/BaseLayout.astro";
import "@/styles/neat-annotations.css";
import "@/styles/journal.css";
import { greetingByHour } from "@/lib/sections";

const initialGreeting = greetingByHour();
---

<BaseLayout
  title="baozi.space — 中华一番包子铺"
  description="打开一本属于包子的手账，在纸张、照片、标签和手写记录之间认识他的文章、想法、摄影、酒、书、音乐和 AI 创作。"
  bodyClass="home-body"
>
  <div class="book-stage is-closed" id="book-stage">
    <!-- 合上的手账：FREITAG F26 AGENDA -->
    <div class="book-closed" id="book-closed" aria-hidden="false">
      <div class="book-cover">
        <span class="cover-title">中华一番</span>
        <span class="cover-subtitle">包子铺</span>
      </div>
    </div>

    <!-- 打开的手账 -->
    <div class="book-open" id="book-open" aria-hidden="true">
      <div class="page-spread" id="page-spread">
        <!-- 左页 -->
        <div class="page page-left" id="page-left">
          <div class="paper-texture"></div>

          <div class="site-mark" aria-hidden="true">baozi.space</div>

          <div class="greeting" id="greeting">
            <span class="greeting-time" id="greeting-time">{initialGreeting}</span>，欢迎光临中华一番包子铺
          </div>

          <span class="date-stamp" id="date-stamp" aria-hidden="true">2026 · 07 · 23</span>

          <p class="intro-note">
            这里不是博客，也不是商店。<br />
            是一本会不断变厚的<br />
            数字手账。
          </p>

          <!-- 圈画：圈住酒罐 -->
          <span class="deco deco-circle" aria-hidden="true"></span>

          <!-- 栏目入口：Drinks -->
          <a href="/drinks" class="scrap scrap-drinks" data-section="drinks">
            <span class="sticker sticker-can">
              <span class="drink-can">
                <span class="drink-label">小猫三只</span>
              </span>
            </span>
            <span class="scrap-label">Drinks</span>
            <span class="scrap-hint">伊势角屋 · 喝过的酒</span>
          </a>

          <!-- 栏目入口：Blog（手绘批注由 neat-annotations 提供） -->
          <a
            href="/blog"
            class="scrap scrap-blog ann ann-n ann-no-mark"
            data-note="最近更新"
            style="--ann-color: #c14a36"
            data-section="blog"
          >
            <span class="scrap-bg"><span class="scrap-icon" aria-hidden="true">✎</span></span>
            <span class="scrap-label">Blog</span>
            <span class="scrap-hint">长文与专题</span>
          </a>

          <!-- 栏目入口：Thoughts -->
          <div class="scrap scrap-thought draggable" data-section="thoughts" tabindex="0" role="link" aria-label="Thoughts 栏目">
            <div class="sticky-note sticky-yellow">
              <p>今日想法：<br />把网页当成房间来布置。</p>
              <span class="sticky-date">07.22</span>
            </div>
            <span class="scrap-label" aria-hidden="true">Thoughts</span>
            <a class="scrap-hit" href="/thoughts">Thoughts</a>
          </div>

          <!-- 栏目入口：Photos -->
          <a href="/photos" class="scrap scrap-photos" data-section="photos">
            <span class="sticker sticker-camera">
              <span class="camera-emoji" aria-hidden="true">📷</span>
              <span class="camera-caption">Canon A-1</span>
            </span>
            <span class="scrap-label">Photos</span>
            <span class="scrap-hint">胶片与生活</span>
          </a>

          <span class="deco deco-note" aria-hidden="true">记录中 →</span>
        </div>

        <!-- 中缝 -->
        <div class="page-seam" aria-hidden="true"></div>

        <!-- 右页 -->
        <div class="page page-right" id="page-right">
          <div class="paper-texture"></div>

          <span class="deco deco-highlight ann ann-amber">important!</span>

          <!-- 栏目入口：About Me -->
          <a href="/about" class="scrap scrap-about" data-section="about">
            <span class="polaroid">
              <span class="tape-strip" aria-hidden="true"></span>
              <span class="polaroid-icon" aria-hidden="true">🙂</span>
              <span class="polaroid-caption">baozi</span>
            </span>
            <span class="scrap-label">About Me</span>
            <span class="scrap-hint">你好，我是包子</span>
          </a>

          <!-- 装饰便签：待整理 -->
          <div class="scrap scrap-tape draggable" data-section="tape" tabindex="0">
            <div class="sticky-note sticky-pink">
              <span class="tape-strip" aria-hidden="true"></span>
              <p>待整理：照片、酒标、唱片清单。</p>
            </div>
          </div>

          <!-- 栏目入口：Books -->
          <a
            href="/books"
            class="scrap scrap-books ann ann-e ann-green ann-no-mark"
            data-note="六月读完的"
            data-section="books"
          >
            <span class="sticker sticker-shelf">
              <span class="shelf" aria-hidden="true">
                <span class="shelf-book shelf-book-1"></span>
                <span class="shelf-book shelf-book-2"></span>
                <span class="shelf-book shelf-book-3"></span>
              </span>
            </span>
            <span class="scrap-label">Books</span>
            <span class="scrap-hint">在读与读过</span>
          </a>

          <!-- 栏目入口：Music -->
          <a
            href="/music"
            class="scrap scrap-music ann ann-e ann-purple ann-no-mark"
            data-note="循环中 ↻"
            data-section="music"
          >
            <span class="sticker sticker-vinyl">
              <span class="vinyl" aria-hidden="true">
                <span class="vinyl-grooves"></span>
                <span class="vinyl-label">♪</span>
              </span>
            </span>
            <span class="scrap-label">Music</span>
            <span class="scrap-hint">最近在听</span>
          </a>

          <!-- 栏目入口：AI Works -->
          <a href="/ai-works" class="scrap scrap-ai" data-section="ai-works">
            <span class="sticker sticker-robot">
              <span class="robot-emoji" aria-hidden="true">🤖</span>
              <span class="robot-name">包子</span>
            </span>
            <span class="scrap-label">AI Works</span>
            <span class="scrap-hint">生成实验</span>
          </a>

          <span class="deco deco-bracket" aria-hidden="true">{ }</span>
        </div>
      </div>
    </div>

    <!-- 栏目标题过渡页 -->
    <div class="section-overlay" id="section-overlay" aria-hidden="true">
      <div class="section-card">
        <span class="section-number" id="section-number">01</span>
        <h2 class="section-title" id="section-title">Blog</h2>
        <p class="section-desc" id="section-desc">完整文章、教程与专题。</p>
        <div class="section-actions">
          <a class="section-enter" id="section-enter" href="/blog">进入栏目 →</a>
          <button class="section-back" id="section-back" type="button">← 留在首页</button>
        </div>
      </div>
    </div>
  </div>

  <button class="replay-btn" id="replay-btn" type="button" aria-label="重新播放打开动效">
    ↻ 重新打开
  </button>

  <script is:inline src="/scripts/journal.js"></script>
</BaseLayout>
