---
import "@/components/intro-oil/intro-oil.css";

/** plate=true 仅在 /lab/intro-oil 使用：交接评审用 iframe；生产场景 1 由后续场景 2 自然衔接 */
const { plate = false } = Astro.props;
const grassSrc = "/assets/intro/runtime/intro-grass.webp";
---

<div class="io-scroll" data-io-scroll>
  <section class="intro-oil-stage" data-intro-oil-stage aria-label="启动页舞台">
    <img
      class="intro-oil-stage__grass"
      data-io="grass"
      src={grassSrc}
      alt=""
      aria-hidden="true"
      draggable="false"
    />
    <!-- 角色层默认隐藏，运行时就绪后逐层点亮；无 JS 时保留静态点阵 + 草地 -->
    <div class="io-sprite io-ball" data-io="ball" aria-hidden="true"></div>
    <div class="io-sprite io-dog" data-io="dog" aria-hidden="true"></div>
    <svg class="io-leash" data-io="leash" aria-hidden="true">
      <path data-io="leash-path" fill="none" />
    </svg>
    <div class="io-sprite io-person" data-io="person" aria-hidden="true"></div>
    <img class="io-still" data-io="still" alt="启动页定帧" aria-hidden="true" />
    {plate && (
      <iframe
        class="io-plate"
        data-io="plate"
        src="/lab/home-v2?capture=video-plate"
        title="Home v2 定帧交接层"
        loading="lazy"
        tabindex="-1"
      ></iframe>
    )}
    <button class="io-skip" data-io="skip" type="button">跳过开场 →</button>
    <pre class="io-debug" data-io="debug" hidden></pre>
  </section>
</div>

<script>
  import { initIntroOilRuntime } from "@/components/intro-oil/runtime";

  const stage = document.querySelector<HTMLElement>("[data-intro-oil-stage]");
  if (stage) {
    const debug = stage.querySelector<HTMLElement>('[data-io="debug"]');
    if (debug && new URLSearchParams(location.search).has("debug")) debug.hidden = false;
    initIntroOilRuntime(stage);
  }
</script>
