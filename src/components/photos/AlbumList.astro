---
import { servedUrl } from "@/lib/site/paths";
import type {PublicAlbum} from "@/lib/photos/albums";
import {albumHref} from "@/lib/photos/routes";
interface Props {albums:PublicAlbum[];}
const {albums}=Astro.props;
---
<section class="album-list album-list--directory" data-album-list aria-labelledby="album-list-title">
  <h2 class="album-directory__sr-only" id="album-list-title" tabindex="-1">影集</h2>
  <div class="album-directory">
    <button class="album-directory__toggle" type="button" data-album-directory-toggle aria-expanded="false" aria-controls="album-directory-options" hidden>
      <span data-album-current-name>{albums[0]?.title}</span><span class="album-directory__chevron" aria-hidden="true"></span>
    </button>
    <nav class="album-segments" id="album-directory-options" data-album-segments aria-label="影集目录">{albums.map((album,index)=><button type="button" data-album-segment={album.id} aria-current={index===0?"true":undefined} aria-controls={`album-cover-${encodeURIComponent(album.id)}`}><span class="album-directory__tick" aria-hidden="true"></span><span>{album.title}</span></button>)}</nav>
  </div>
  <div class="album-gallery">
   <ul class="album-strip" data-album-strip data-lenis-prevent-wheel>
    {albums.map(album=><li><a id={`album-cover-${encodeURIComponent(album.id)}`} class="album-cover" data-album-id={album.id} href={albumHref(album.id)} aria-label={album.title}>
      <div class="album-cover__image"><img src={servedUrl(album.cover.src)} width={album.cover.width} height={album.cover.height} alt={album.cover.alt} style={`object-position: ${album.coverPosition?.x ?? 50}% ${album.coverPosition?.y ?? 50}%`} loading="lazy" decoding="async" draggable="false" /><span class="album-cover__error" data-album-cover-error hidden>封面暂不可用</span></div>
      <p class="album-cover__meta">{album.periodLabel??album.date?.getFullYear()}<span>{album.photos.length} 张照片</span></p>
    </a></li>)}
   </ul>
   <div class="album-list__controls" data-album-controls hidden><button type="button" data-album-prev aria-label="向前浏览影集">←</button><button type="button" data-album-next aria-label="向后浏览影集">→</button></div>
  </div>
</section>
