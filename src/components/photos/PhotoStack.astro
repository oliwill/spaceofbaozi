---
import { servedUrl } from "@/lib/site/paths";
import type { PublicAlbum } from "@/lib/photos/albums";

interface Props {
  album: PublicAlbum;
}

const { album } = Astro.props;
const formatDate = (date: Date) => date.toLocaleDateString("zh-CN");
const titleId = `photo-feature-${album.id}`;
---

<section class="photo-feature" aria-labelledby={titleId}>
  <div class="photo-feature__copy">
    <p class="editorial-feature__label">最新相册</p>
    <div class="editorial-meta">
      <time datetime={album.date?.toISOString()}>{album.date ? formatDate(album.date) : ""}</time>
      {[].map((tag) => <span>#{tag}</span>)}
    </div>
    <h2 id={titleId}>
      <a href={servedUrl(`/photos/${album.id}`)}>{album.title}</a>
    </h2>
    {album.introduction && <p class="editorial-feature__summary">{album.introduction}</p>}
    <a class="editorial-text-link" href={servedUrl(`/photos/${album.id}`)}>进入相册 →</a>
  </div>

  {album.cover.src && (
    <a
      class="photo-feature__cover entry-link"
      href={servedUrl(`/photos/${album.id}`)}
      aria-label={`预览《${album.title}》封面`}
    >
      <img
        src={servedUrl(album.cover.src)}
        alt={album.cover.alt}
        loading="eager"
        decoding="async"
      />
      {album.cover.credit && <span>{album.cover.credit}</span>}
    </a>
  )}
</section>
