<div class="reading-progress" data-reading-progress role="progressbar" aria-label="正文阅读进度" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" hidden>
  <div class="reading-progress__caption" aria-hidden="true">
    <span>阅读进度</span>
    <span class="reading-progress__number" data-reading-percent>0%</span>
  </div>
  <div class="reading-chase" data-reading-track aria-hidden="true">
    <span class="reading-chase__ground"></span>
    <span class="reading-chase__dog" data-reading-dog>
      <span class="reading-chase__sprite" data-reading-dog-sprite></span>
    </span>
    <span class="reading-chase__ball" data-reading-ball></span>
  </div>
</div>
