---
import { servedUrl } from "@/lib/site/paths";
interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
---

<a class="editorial-back-button" href={servedUrl(href)} data-editorial-back data-visible="false" hidden>{label}</a>

<script>
  let controller: AbortController | undefined;
  const setup = () => {
    controller?.abort();
    controller = new AbortController();
    const backButton = document.querySelector<HTMLElement>("[data-editorial-back]");
    if (!backButton) return;
    const update = () => {
      const visible = window.scrollY > 360;
      backButton.hidden = !visible;
      backButton.dataset.visible = String(visible);
    };
    update();
    window.addEventListener("scroll", update, { passive: true, signal: controller.signal });
  };
  document.addEventListener("astro:before-swap", () => controller?.abort());
  document.addEventListener("astro:page-load", setup);
  setup();
</script>
