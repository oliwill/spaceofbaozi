---
import { canonicalUrl } from "@/lib/site/paths";
import { servedUrl } from "@/lib/site/paths";
import "@/styles/global.css";
import "@/components/layout/shell.css";
import { ClientRouter } from "astro:transitions";
import SiteRail from "@/components/layout/SiteRail.astro";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  home?: boolean;
  reading?: boolean;
  photos?: "list"|"reader";
}

const canonical = canonicalUrl(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const {
  title = "baozi.space — 中华一番包子铺",
  description = "包子的个人空间：写作、照片、书影音与正在做的事。",
  noindex = false,
  home = false,
  reading = false,
  photos,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f0efea" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={servedUrl('/favicon.svg')} type="image/svg+xml" />
    <title>{title}</title>
    <ClientRouter fallback="none" />
  </head>
  <body class:list={["shell-body", { "shell-body--home": home }]}>
    <a class="skip-link" href="#main">跳到正文</a>
    <slot name="intro" />
    <div class="site-shell" id={home ? "home" : undefined}>
      <SiteRail reading={reading} home={home} photos={photos} />
      <main id="main" transition:name="page-card" tabindex="-1">
        <slot />
      </main>
    </div>
    <div class="turn-mask" data-turn-mask data-direction="next" data-phase="idle" aria-hidden="true" transition:persist />
    <div class="turn-exit" data-turn-exit aria-hidden="true" transition:persist />
    <script>
      import { initDocumentScroll } from "@/lib/scroll/documentScroll";
      import { initPageTurn } from "@/lib/transitions/pageTurn";
      import { initAlbumLifecycle } from "@/lib/photos/albumLifecycle";
      import { initProjectLifecycle } from "@/lib/projects/projectLifecycle";

      initPageTurn();

      initDocumentScroll();
      initAlbumLifecycle();
      initProjectLifecycle();
    </script>
  </body>
</html>
