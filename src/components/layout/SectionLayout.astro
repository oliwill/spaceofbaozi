---
import { servedUrl } from "@/lib/site/paths";
import ShellLayout from "@/components/layout/ShellLayout.astro";
import EditorialHero from "@/components/editorial/EditorialHero.astro";
import "@/components/editorial/editorial.css";
import { type SectionMeta } from "@/lib/sections";

interface Props {
  section: SectionMeta;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { section, title, description, noindex = false } = Astro.props;
const pageTitle = title
  ? `${title} · ${section.title} · baozi.space`
  : `${section.title} · baozi.space`;
const pageDesc = description ?? section.desc;
---

<ShellLayout title={pageTitle} description={pageDesc} noindex={noindex}>
  <section class="editorial-page">
    <a class="article-page__back" href={servedUrl('/#home')} data-turn="back">← 返回首页</a>
    <slot name="header">
      <EditorialHero kicker={section.title} title={title ?? section.zh} description={pageDesc} />
    </slot>
    <slot />
  </section>
</ShellLayout>
