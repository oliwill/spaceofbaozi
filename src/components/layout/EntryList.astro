---
import { servedUrl } from "@/lib/site/paths";
import type { CollectionEntry } from "astro:content";
import { isPublishable } from "@/lib/content/gates";
import type { EntrySchemaCollectionKey } from "@/lib/sections";
import "@/components/editorial/editorial.css";

interface Props {
  entries: CollectionEntry<EntrySchemaCollectionKey>[];
  emptyHint?: string;
  tagBaseHref?: string;
}
const {
  entries,
  emptyHint = "这一栏的内容正在整理。",
  tagBaseHref,
} = Astro.props;

const sorted = [...entries]
  .filter((e) => isPublishable(e.data))
  .sort((a, b) => +b.data.date - +a.data.date);
---

{
  sorted.length === 0 ? (
    <div class="editorial-empty">
      <p>
        <strong>暂无记录。</strong>
      </p>
      <p>{emptyHint}</p>
    </div>
  ) : (
    <ul class="editorial-list">
      {sorted.map((entry) => (
        <li>
          {entry.data.cover && (
            <figure class="archive-cover">
              <img
                src={servedUrl(entry.data.cover)}
                alt={entry.data.coverAlt ?? entry.data.title}
                loading="lazy"
                decoding="async"
              />
              {entry.data.coverCredit && (
                <figcaption>{entry.data.coverCredit}</figcaption>
              )}
            </figure>
          )}
          <div class="editorial-meta">
            <time datetime={entry.data.date.toISOString()}>
              {entry.data.date.toLocaleDateString("zh-CN")}
            </time>
            {entry.data.tags?.slice(0, 3).map((tag) =>
              tagBaseHref ? (
                <a class="editorial-tag" href={servedUrl(`${tagBaseHref}/${encodeURIComponent(tag)}`)}>
                  #{tag}
                </a>
              ) : (
                <span class="editorial-tag">#{tag}</span>
              )
            )}
          </div>
          <h2>
            <a href={servedUrl(`/${entry.collection}/${entry.id}`)}>
              {entry.data.title}
            </a>
          </h2>
          {entry.data.description && <p>{entry.data.description}</p>}
        </li>
      ))}
    </ul>
  )
}

<style>
  .archive-cover { margin: 0 0 1.5rem; }
  .archive-cover img { display: block; max-width: 100%; max-height: 360px; width: auto; height: auto; }
  .archive-cover figcaption { margin-top: 0.5rem; color: var(--ink-light); font-size: 0.8rem; }
</style>
