---
import { servedUrl } from "@/lib/site/paths";
import { render, type CollectionEntry } from "astro:content";
import ShellLayout from "@/components/layout/ShellLayout.astro";
import "@/components/editorial/editorial.css";
import { type SectionMeta, type EntrySchemaCollectionKey } from "@/lib/sections";

interface Props {
  section: SectionMeta;
  entry: CollectionEntry<EntrySchemaCollectionKey>;
}

const { section, entry } = Astro.props;
const { Content } = await render(entry);
const pageTitle = `${entry.data.title} · ${section.title} · baozi.space`;
const pageDesc = entry.data.description || section.desc;
const date = entry.data.updated ?? entry.data.date;
---

<ShellLayout title={pageTitle} description={pageDesc}>
  <article class="editorial-page article-page">
    <a class="article-page__back" href={servedUrl(section.href)} data-turn="back">← 返回{section.zh}</a>
    <header class="article-page__header">
      <p class="editorial-hero__kicker">{section.title}</p>
      <h1>{entry.data.title}</h1>
      {entry.data.description && <p class="article-page__description">{entry.data.description}</p>}
      <div class="editorial-meta article-page__meta">
        <time datetime={date.toISOString()}>
          {entry.data.updated && "更新于 "}{date.toLocaleDateString("zh-CN")}
        </time>
        {entry.data.tags.map((tag) => <span class="editorial-tag">#{tag}</span>)}
        {entry.data.status && <span>{entry.data.status}</span>}
      </div>
    </header>
    {entry.data.cover && (
      <figure class="article-page__cover">
        <img src={servedUrl(entry.data.cover)} alt={entry.data.coverAlt ?? entry.data.title} decoding="async" />
        {entry.data.coverCredit && <figcaption>{entry.data.coverCredit}</figcaption>}
      </figure>
    )}
    <div class="editorial-prose">
      <Content />
      {entry.data.link && (
        <p>
          <a href={servedUrl(entry.data.link)} target="_blank" rel="noopener noreferrer">在新标签阅读原文 ↗</a>
        </p>
      )}
    </div>
    <nav class="article-page__nav" aria-label="记录导航">
      <a href={servedUrl(section.href)} data-turn="back">返回{section.zh}</a>
    </nav>
  </article>
</ShellLayout>
