---
import type { CollectionEntry, CollectionKey } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import BookSpread from "./BookSpread.astro";
import { type SectionMeta } from "@/lib/sections";

interface Props {
  section: SectionMeta;
  entry: CollectionEntry<CollectionKey>;
}

const { section, entry } = Astro.props;

// 左栏导航变体：相册目录 / 关于无导航 / 其余标签导航
const navVariant =
  section.key === "photos" ? "album-index" : section.key === "about" ? "none" : "tags";

const pageTitle = `${entry.data.title} · ${section.title} · baozi.space`;
const pageDesc = entry.data.description || section.desc;
---

<BaseLayout title={pageTitle} description={pageDesc} bodyClass="section-body">
  <BookSpread section={section} entry={entry} navVariant={navVariant} />
</BaseLayout>
