---
import { render } from "astro:content";
import type { CollectionEntry, CollectionKey } from "astro:content";
import SectionLayout from "./SectionLayout.astro";
import { type SectionMeta } from "@/lib/sections";

interface Props {
  section: SectionMeta;
  entry: CollectionEntry<CollectionKey>;
}

const { section, entry } = Astro.props;
const { Content } = await render(entry);
---

<SectionLayout
  section={section}
  title={entry.data.title}
  description={entry.data.description || section.desc}
>
  <article class="prose" slot="header">
    <span class="section-kicker">{section.number} · {section.title}</span>
    <h1>{entry.data.title}</h1>
    <div class="entry-meta">
      <time class="date-chip" datetime={entry.data.date.toISOString()}>
        {entry.data.date.toLocaleDateString("zh-CN")}
      </time>
      {entry.data.tags?.map((tag) => <span class="tag">#{tag}</span>)}
      {entry.data.status && <span class="tag">{entry.data.status}</span>}
    </div>
  </article>

  <article class="prose">
    <Content />
    {
      entry.data.link && (
        <p class="link-out">
          <a href={entry.data.link} target="_blank" rel="noopener noreferrer">
            在新标签阅读原文 ↗
          </a>
        </p>
      )
    }
  </article>
</SectionLayout>
